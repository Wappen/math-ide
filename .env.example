# Copy to .env and fill in one provider key (or both; Anthropic is preferred).
# .env is gitignored — never commit real keys.

# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Optional: override the OpenAI model (default: gpt-4o)
# OPENAI_MODEL=gpt-4o

# Optional: opt in to live-LLM acceptance tests (see tests/README.md)
# RUN_LLM_TESTS=1
